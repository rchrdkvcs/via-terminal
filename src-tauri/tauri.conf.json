{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Via",
  "mainBinaryName": "Via",
  "version": "0.2.1",
  "identifier": "dev.viaterminal.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Via",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "appimage", "deb"],
    "category": "DeveloperTool",
    "publisher": "Via",
    "shortDescription": "Via \u2014 native terminal workspace",
    "windows": {
      "nsis": {
        "startMenuFolder": "Via"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "hardenedRuntime": true
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzNTY2MUVFMDVDRUYyRkQKUldUOThzNEY3bUZXbzlScHVrbE5od21XbmZaTXhGZzlsRVFYelcxU2VETVY1cXc5aHB0YmN6MHUK",
      "endpoints": [
        "https://github.com/rchrdkvcs/via-terminal/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
