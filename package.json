{
  "name": "via-terminal",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint src vite.config.ts vitest.config.ts",
    "format:check": "oxfmt --check .",
    "format": "oxfmt --write .",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:smoke": "node .ai/cdp-smoke.mjs",
    "test:release": "node --test .github/scripts/*.test.mjs"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lucide/vue": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@vueuse/core": "^15.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.44",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "playwright-core": "~1.64.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
